meta {
  name: Create source account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/account
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accountNumber": "SYS-FUND-USD",
    "currency": "USD"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("sourceAccountId", String(res.getBody().id));
  }
}
