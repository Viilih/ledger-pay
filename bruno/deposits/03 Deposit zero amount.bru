meta {
  name: Deposit zero amount
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/deposits
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accountId": {{sourceAccountId}},
    "currency": "BRL",
    "amount": 0,
    "idempotencyKey": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbb1",
    "description": "zero amount"
  }
}

tests {
  test("rejects amount that is not greater than zero", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
