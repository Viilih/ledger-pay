meta {
  name: Deposit retry same key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/deposits
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accountId": {{sourceAccountId}},
    "currency": "BRL",
    "amount": 10000,
    "idempotencyKey": "{{depositIdempotencyKey}}",
    "description": "Initial deposit"
  }
}

docs {
  Mesmo body do Deposit. Deve devolver o mesmo 200 sem gravar novas entries.
  Rode depois do **Deposit**, com a mesma `depositIdempotencyKey` do ambiente.
}

tests {
  test("replays the stored deposit", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.accountId).to.equal(Number(bru.getEnvVar("sourceAccountId")));
    expect(body.amount).to.equal(10000);
    expect(body.currency).to.equal("BRL");
    expect(body.idempotencyKey).to.equal(bru.getEnvVar("depositIdempotencyKey"));
    expect(body.status).to.equal("COMPLETED");
  });
}
